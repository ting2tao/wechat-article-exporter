# 调试微信代理请求 (仅开发环境(development)支持)
NUXT_DEBUG_MP_REQUEST=false

# 当本机缺少微信证书链时，允许对微信公众号请求放宽 TLS 校验
# 开发环境默认会自动兜底重试；生产环境如确有需要可显式开启
NUXT_MP_ALLOW_INSECURE_TLS=false

# AG-Grid 企业版授权
NUXT_AGGRID_LICENSE=

# KV绑定(本地/docker)
NITRO_KV_DRIVER=fs
NITRO_KV_BASE=.data/kv

# KV绑定(cloudflare)
#NITRO_KV_DRIVER=cloudflare-kv-binding

DEBUG_KEY=
